# Instancia de Supabase self-hosted (URL pública, clave anon y clave
# service_role del proyecto). El schema por defecto es "public"; solo hace
# falta tocar SUPABASE_DB_SCHEMA si esta instancia se comparte con otra app
# (ej. r-s_stundenerfassung) usando un schema Postgres separado por app.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tu-dominio.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=public
