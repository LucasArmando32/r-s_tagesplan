# Base de datos SQLite embebida (un solo archivo, sin servicio/contenedor
# propio). Opcional: por defecto se crea en ./data/tablero.db (relativo al
# directorio desde donde corre el proceso). En producción, apuntar a un
# archivo dentro de un volumen persistente montado en el contenedor.
DB_PATH=./data/tablero.db

# Host (sin protocolo, sin barra final) que sirve la página pública de solo lectura.
# En producción: el subdominio que se comparte por WhatsApp y se rota cada 2-3 meses.
# En desarrollo local, usar "localhost:3000" para poder previsualizar la página pública.
PUBLIC_SITE_HOST=tablero.rs-asbestsanierung.ch
